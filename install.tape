# Pixie SDDM — install demo
# Render with:  cd /tmp && vhs /home/captain/pixie-sddm/install.tape
Set Shell bash
Set FontSize 14
Set Width 960
Set Height 540
Set Theme "Catppuccin Mocha"
Set Padding 20
Set TypingSpeed 0.04
Output install.gif

# 1. Clone the repository
Type "git clone https://github.com/xCaptaiN09/pixie-sddm.git"
Enter
Sleep 12s

# 2. Enter it
Type "cd pixie-sddm"
Enter
Sleep 1s

# 3. Run the installer
Type "sudo ./install.sh"
Enter
Sleep 3s

# Confirm applying the theme
Type "y"
Enter
Sleep 4s
